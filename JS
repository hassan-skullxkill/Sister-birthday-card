
const wishBtn = document.getElementById("wishBtn");
const envelope = document.getElementById("envelope");
const letter = document.getElementById("letter");
const confettiContainer = document.getElementById("confetti-container");

// Floating hearts and stars

function createDecoration() {
    const decoration = document.createElement("div");

    const symbols = ["❤️", "💕", "✨", "🌸", "💖", "⭐"];

    decoration.className = "decoration";
    decoration.textContent =
        symbols[Math.floor(Math.random() * symbols.length)];

    decoration.style.left = Math.random() * 100 + "vw";
    decoration.style.fontSize = (15 + Math.random() * 25) + "px";
    decoration.style.animationDuration =
        (4 + Math.random() * 4) + "s";

    document.body.appendChild(decoration);

    setTimeout(() => decoration.remove(), 8000);
}

setInterval(createDecoration, 450);

// Birthday celebration

function celebrate() {
    for (let i = 0; i < 100; i++) {
        const piece = document.createElement("div");

        piece.textContent = ["🎉", "✨", "💖", "🎊"][
            Math.floor(Math.random() * 4)
        ];

        piece.style.position = "fixed";
        piece.style.left = Math.random() * 100 + "vw";
        piece.style.top = "-30px";
        piece.style.fontSize = "22px";
        piece.style.zIndex = "100";
        piece.style.pointerEvents = "none";

        document.body.appendChild(piece);

        const duration = 2000 + Math.random() * 2500;

        piece.animate([
            { transform: "translateY(0) rotate(0deg)", opacity: 1 },
            {
                transform:
                    `translateY(${window.innerHeight + 100}px) rotate(720deg)`,
                opacity: 0
            }
        ], {
            duration: duration,
            easing: "ease-in"
        });

        setTimeout(() => piece.remove(), duration);
    }
}

wishBtn.addEventListener("click", () => {
    celebrate();
    wishBtn.textContent = "Happy Birthday, Sister! ❤️";
});

// Open special letter

envelope.addEventListener("click", () => {
    letter.style.display = "block";
    envelope.style.display = "none";

    celebrate();

    letter.scrollIntoView({
        behavior: "smooth",
        block: "center"
    });
});
