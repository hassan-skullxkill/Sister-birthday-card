
@import url('https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg, #1b1035, #47205f, #9b477f);
    color: white;
    overflow-x: hidden;
    text-align: center;
}

.container {
    width: 90%;
    max-width: 750px;
    margin: auto;
    padding: 65px 15px;
}

.tag {
    display: inline-block;
    padding: 10px 20px;
    border: 1px solid #ffb6dc;
    border-radius: 30px;
    color: #ffc7e5;
    font-size: 11px;
    letter-spacing: 3px;
    margin-bottom: 25px;
}

h1 {
    font-size: clamp(42px, 8vw, 75px);
    color: #ffd2e8;
    font-family: 'Great Vibes', cursive;
    text-shadow: 0 0 25px #ff80c0;
}

h2 {
    font-size: clamp(20px, 5vw, 32px);
    margin: 10px 0;
}

.intro {
    max-width: 520px;
    margin: 20px auto;
    color: #f5d9ee;
    line-height: 1.8;
    font-size: 14px;
}

/* Birthday Cake */

.cake {
    position: relative;
    width: 180px;
    height: 160px;
    margin: 55px auto 20px;
}

.cake-bottom {
    position: absolute;
    bottom: 0;
    width: 180px;
    height: 75px;
    background: linear-gradient(90deg, #ff8bbd, #ffc5dc);
    border-radius: 12px 12px 20px 20px;
    box-shadow: 0 12px 25px #0005;
}

.cake-top {
    position: absolute;
    bottom: 65px;
    left: 10px;
    width: 160px;
    height: 35px;
    background: #ffe4ed;
    border-radius: 50%;
    z-index: 2;
}

.icing {
    position: absolute;
    bottom: 45px;
    left: 10px;
    width: 160px;
    height: 35px;
    border-radius: 0 0 15px 15px;
    background: #ffb6d2;
    z-index: 3;
}

.candle {
    position: absolute;
    bottom: 100px;
    left: 84px;
    width: 12px;
    height: 38px;
    background: repeating-linear-gradient(
        45deg,
        #fff,
        #fff 5px,
        #ff69a8 5px,
        #ff69a8 10px
    );
    z-index: 5;
}

.flame {
    position: absolute;
    top: -19px;
    left: 2px;
    width: 9px;
    height: 18px;
    background: #ffdf65;
    border-radius: 50%;
    box-shadow: 0 0 20px #ffbd45;
    animation: flicker 0.5s infinite alternate;
}

@keyframes flicker {
    from { transform: scale(1); }
    to { transform: scale(1.2) rotate(8deg); }
}

.wish {
    color: #ffd6ed;
    margin: 15px;
    font-size: 16px;
}

button {
    padding: 15px 28px;
    border: none;
    border-radius: 35px;
    background: linear-gradient(90deg, #ff72b6, #ffb0d5);
    color: #421637;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    box-shadow: 0 5px 25px #ff72b655;
    transition: 0.3s;
}

button:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px #ff72b688;
}

.envelope {
    margin: 55px auto 20px;
    padding: 25px;
    max-width: 300px;
    background: #ffffff15;
    border: 1px solid #ffffff40;
    border-radius: 20px;
    cursor: pointer;
    transition: 0.3s;
}

.envelope:hover {
    background: #ffffff25;
    transform: scale(1.04);
}

.envelope-icon {
    font-size: 55px;
}

.envelope p {
    color: #ffd6ed;
    margin-top: 10px;
}

.letter {
    display: none;
    margin: 30px auto;
    padding: 35px 25px;
    max-width: 550px;
    background: #fff1f7;
    color: #61294d;
    border-radius: 20px;
    box-shadow: 0 10px 40px #0004;
    line-height: 2;
    animation: appear 0.7s ease;
}

.letter h2 {
    color: #d34b91;
    font-family: 'Great Vibes', cursive;
    font-size: 35px;
}

.letter p {
    margin: 15px 0;
    font-size: 14px;
}

.letter h3 {
    color: #e44f96;
    margin-top: 20px;
}

.signature {
    margin-top: 25px;
    font-style: italic;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

footer {
    margin-top: 65px;
    font-size: 12px;
    color: #e9b9d9;
}

/* Floating decorations */

.decoration {
    position: fixed;
    bottom: -30px;
    pointer-events: none;
    animation: floatUp 6s linear forwards;
    z-index: 10;
}

@keyframes floatUp {
    to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
}

@media(max-width: 500px) {
    .container {
        padding-top: 45px;
    }

    .letter {
        padding: 25px 18px;
    }
}
